# DROPLET — Arduino Uno Gateway Configuration
# Copy this file to .env and fill in your actual values.
# Do NOT commit .env to version control.

# ── Serial port ───────────────────────────────────────────────────────────────
# Windows examples: COM3, COM5, COM9
# Linux/macOS:      /dev/ttyUSB0, /dev/ttyACM0
# Leave blank to enable auto-detection (picks first Arduino-like port).
SERIAL_PORT=COM9

# Baud rate — must match the value in water_quality_uno_final.ino (Serial.begin)
SERIAL_BAUD=9600

# ── Backend API ───────────────────────────────────────────────────────────────
# Local development:
# API_URL=http://localhost:8000
# Render cloud (production):
API_URL=https://droplet-api-byl8.onrender.com

# ── Retry / backoff ───────────────────────────────────────────────────────────
# Number of HTTP retry attempts per reading before giving up
RETRY_LIMIT=3
# Initial retry delay in seconds (doubles on each failure, capped at 30 s)
RETRY_DELAY_S=2.0
