# ==========================================
# VERCEL ENVIRONMENT VARIABLES (DROPLET)
# ==========================================
# Copy and paste these into your Vercel Project Settings:
# Settings -> Environment Variables

# Setting VITE_API_BASE_URL to /api routes all traffic through Vercel's edge proxy
# rewrites (vercel.json), eliminating all browser CORS issues and cold-start blocking.
VITE_API_BASE_URL=/api
VITE_API_TARGET=https://droplet-api-byl8.onrender.com
