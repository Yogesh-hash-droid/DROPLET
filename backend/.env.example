# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# P2 admin authentication for PUT /api/config (backend/app/security.py).
# Leave EMPTY to keep configuration updates disabled (server returns HTTP 503).
# Set the real value ONLY in the untracked backend/.env at deployment time.
# Never commit a real key to source control.
ADMIN_API_KEY=

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=water_quality_db

# Optional explicit SQLAlchemy database URL (overrides individual credentials if provided)
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/water_quality_db

# ML Model Path (relative to backend or absolute)
MODEL_PATH=../ml/models/water_potability_model.joblib
METRICS_PATH=../ml/models/model_metrics.json
